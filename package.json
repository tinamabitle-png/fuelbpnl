{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "proxy": "npm --prefix lan-proxy start",
        "proxy:install": "npm --prefix lan-proxy install"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "6.4.1"
    },
    "overrides": {
        "esbuild": "0.24.2",
        "@esbuild/darwin-x64": "0.24.2"
    }
}
